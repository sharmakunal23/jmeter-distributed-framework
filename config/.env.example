# =============================================================================
# JMeter Distributed Framework - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_ACCOUNT_ID=123456789012

# EC2 Configuration
EC2_KEY_PAIR_NAME=jmeter-framework-key
EC2_AMI_ID=ami-0c7217cdde317cfec

# S3 Configuration
S3_BUCKET_NAME=jmeter-results-bucket
S3_RESULTS_PREFIX=results/

# Docker Registry (optional - for ECR)
DOCKER_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# JMeter Configuration
JMETER_VERSION=5.6.3
JMETER_HEAP_CONTROLLER=-Xms2g -Xmx4g
JMETER_HEAP_WORKER=-Xms2g -Xmx4g

# Logging
LOG_LEVEL=INFO
